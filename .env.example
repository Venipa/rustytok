# Server listen port (default: 3000)
PORT=3000

# Logging filter for tracing-subscriber (default when unset: rustytok=info)
# Examples: rustytok=debug, info, warn, error
RUST_LOG=rustytok=info

# Antibot tokens (ProxiTok-compatible)
# From TikTok browser cookies after solving captcha: copy s_v_web_id
# API_VERIFYFP=verify_...
# Optional device id (tt_webid / tt_webid_v2)
# API_DEVICE_ID=586094...
# Required for video CDN (v16-webapp-prime); cookie name tt_chain_token
# Also refreshed automatically from TikTok Set-Cookie when fetching a video page
# API_TT_CHAIN_TOKEN=...
